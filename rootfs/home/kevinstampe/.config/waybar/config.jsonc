{
"margin": "5",
  "margin-bottom": "0",
  "position": "top",
  "modules-left": ["custom/wofi", "hyprland/workspaces"],
  "modules-center": ["hyprland/window", "custom/close"],
  "modules-right": ["custom/cpu-ram", "custom/gpu-vram", "battery", "pulseaudio", "network", "clock", "custom/keyboard", "custom/power"],
 "hyprland/window": {
    "format": "{title}",
    "max-length": 120,
    "tooltip": true,
    "tooltip-format": "{title}"
 },
 "custom/close": {
    "format": "✕",
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.window.close()'"
 },
 "custom/wofi": {
    "format": " ●",
    "tooltip": false,
    "on-click": "wofi -S drun -i"
 },
  "clock": {
    "format": "<span foreground='#b16286'>\uf017 </span>{:%Y.%m.%d %H:%M:%S} ",
    "interval": 1,
    "tooltip": false,
    "on-click": "~/.config/hypr/calendar-toggle.sh"
 },
  "custom/cpu-ram": {
    "format": "{} ",
    "exec": "~/.config/waybar/scripts/cpu-ram.sh",
    "interval": 1,
    "on-click": "ghostty -e btop"
  },
  "custom/gpu-vram": {
    "format": "{} ",
    "exec": "~/.config/waybar/scripts/gpu-vram.sh",
    "interval": 1,
    "on-click": "ghostty -e nvtop"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='13000' foreground='#98971a'>{icon}</span> {capacity:03}% ",
    "format-warning": "<span size='13000' foreground='#98971a'>{icon}</span> {capacity:03}% ",
    "format-critical": "<span size='13000' foreground='#98971a'>{icon}</span> {capacity:03}% ",
    "format-charging": "<span size='13000' foreground='#98971a'></span> {capacity:03}% ",
    "format-plugged": "<span size='13000' foreground='#98971a'></span> {capacity:03}% ",
    "format-alt": "<span size='13000' foreground='#98971a'>{icon}</span> {time} ",
    "format-full": "<span size='13000' foreground='#98971a'></span> {capacity:03}% ",
    "format-icons": ["", "", "", ""],
    "tooltip-format": "{time}",
    "menu": "on-click",
    "menu-file": "/home/kevinstampe/.config/waybar/battery-menu.xml",
    "menu-actions": {
      "quiet": "asusctl profile set Quiet",
      "balanced": "asusctl profile set Balanced",
      "performance": "asusctl profile set Performance"
    }
  },
  "network": {
    "format-wifi": "<span size='13000' foreground='#d79921'>  </span>{essid} ",
    "format-ethernet": "<span size='13000' foreground='#d79921'> </span>{ifname} ",
    "format-linked": "<span size='13000' foreground='#d79921'> </span>{ifname} ",
    "format-disconnected": "<span size='13000' foreground='#d79921'> </span>{ifname} ",
    "max-length": 25,
    "on-click": "networkmanager_dmenu",
    "on-click-right": "nm-connection-editor"
  },
  "pulseaudio": {
      "format": "<span size='13000' foreground='#458588'>{icon} </span>{volume:03}% ",
      "format-muted": "",
      "format-icons": {
          "default": ["", "", " "]
      },
      "on-click": "pavucontrol"
  },
  "custom/keyboard": {
    "format": "{}",
    "tooltip": false,
    "exec": "if [ -f \"${XDG_RUNTIME_DIR:-/tmp}/wvkbd.visible\" ]; then echo '{\"text\":\"󰌌\",\"class\":\"active\"}'; else echo '{\"text\":\"󰌌\",\"class\":\"inactive\"}'; fi",
    "return-type": "json",
    "signal": 8,
    "on-click": "zsh ~/.config/hypr/osk-toggle.sh"
  },
  "custom/power": {
    "format": "  ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "/home/kevinstampe/.config/waybar/power-menu.xml",
    "menu-actions": {
      "shutdown": "systemctl poweroff",
      "restart": "systemctl reboot",
      "logoff": "hyprctl dispatch 'hl.dsp.exit()'"
    }
  }
}

