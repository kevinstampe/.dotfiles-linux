{
"margin": "5",
  "margin-bottom": "0",
  "position": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["cpu", "memory", "custom/gpu-usage", "network", "pulseaudio", "battery", "clock", "custom/power"],
 "clock": {
    "format": "<span foreground='#b16286'>   </span>{:%Y.%m.%d %H:%M}  ",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
 },
 "cpu": {
	"interval": 1,
	"format": "<span size='13000' foreground='#6666ff'> </span>{usage}% ",
	"max-length": 10
  },
  "custom/gpu-usage": {
    "format": "{} ",
    "exec": "gpu-usage-waybar",
    "return-type": "json",
    "format-icons": "󰾲",
    "on-click": "ghostty -e nvtop"
  },
  "memory": {
    "format": "<span size='13000' foreground='#66ff66'>󰍛 </span>{percentage}%  ",
    "interval": 1
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='13000' foreground='#98971a'>{icon}</span>  {capacity}%  ",
    "format-warning": "<span size='13000' foreground='#98971a'>{icon}</span>  {capacity}%  ",
    "format-critical": "<span size='13000' foreground='#98971a'>{icon}</span>  {capacity}%  ",
    "format-charging": "<span size='13000' foreground='#98971a'></span>  {capacity}%  ",
    "format-plugged": "<span size='13000' foreground='#98971a'></span>  {capacity}%  ",
    "format-alt": "<span size='13000' foreground='#98971a'>{icon}</span>  {time}  ",
    "format-full": "<span size='13000' foreground='#98971a'></span>   {capacity}%  ",
    "format-icons": ["", "", "", ""],
    "tooltip-format": "{time}"
  },
  "network": {
    "format-wifi": "<span size='13000' foreground='#d79921'> </span> {essid}  ",
    "format-ethernet": "<span size='13000' foreground='#d79921'> </span>{ifname}  ",
    "format-linked": "<span size='13000' foreground='#d79921'></span>{ifname}  ",
    "format-disconnected": "<span size='13000' foreground='#d79921'> </span>{ifname}  ",
    "max-length": 15,
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
      "format": " <span size='13000' foreground='#458588'>{icon}</span>  {volume}%  ",
      "format-muted": "",
      "format-icons": {
          "default": ["", "", " "]
      },
      "on-click": "pavucontrol"
  },
  "custom/power": {
    "format": " ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "/home/kevinstampe/.config/waybar/power-menu.xml",
    "menu-actions": {
      "shutdown": "systemctl poweroff",
      "restart": "systemctl reboot",
      "logoff": "hyprctl dispatch exit"
    }
  }
}
