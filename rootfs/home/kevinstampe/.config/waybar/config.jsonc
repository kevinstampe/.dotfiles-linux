{
"margin": "5",
  "margin-bottom": "0",
  "position": "top",
  "modules-left": ["custom/wofi", "hyprland/workspaces"],
  "modules-center": ["hyprland/window", "custom/close"],
  "modules-right": ["cpu", "memory", "custom/gpu-usage", "network", "pulseaudio", "battery", "clock", "custom/keyboard", "custom/power"],
 "custom/close": {
    "format": "✕",
    "tooltip": false,
    "on-click": "hyprctl dispatch killactive"
 },
 "custom/wofi": {
    "format": " ●",
    "tooltip": false,
    "on-click": "wofi -S drun -i"
 },
  "clock": {
    "format": "<span foreground='#b16286'>\uf017 </span>{:%Y.%m.%d %H:%M:%S} ",
    "interval": 1,
    "tooltip": false,
    "on-click": "~/.config/hypr/calendar-toggle.sh"
 },
 "cpu": {
	"interval": 1,
	"format": "<span size='13000' foreground='#6666ff'> </span>{usage}% ",
	"max-length": 10
  },
  "custom/gpu-usage": {
    "format": "{} ",
    "exec": "gpu-usage-waybar",
    "return-type": "json",
    "format-icons": "󰾲",
    "on-click": "ghostty -e nvtop"
  },
  "memory": {
    "format": "<span size='13000' foreground='#66ff66'>󰍛 </span>{percentage}% ",
    "interval": 1
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='13000' foreground='#98971a'>{icon}</span> {capacity}% ",
    "format-warning": "<span size='13000' foreground='#98971a'>{icon}</span> {capacity}% ",
    "format-critical": "<span size='13000' foreground='#98971a'>{icon}</span> {capacity}% ",
    "format-charging": "<span size='13000' foreground='#98971a'></span> {capacity}% ",
    "format-plugged": "<span size='13000' foreground='#98971a'></span> {capacity}% ",
    "format-alt": "<span size='13000' foreground='#98971a'>{icon}</span> {time} ",
    "format-full": "<span size='13000' foreground='#98971a'></span> {capacity}% ",
    "format-icons": ["", "", "", ""],
    "tooltip-format": "{time}"
  },
  "network": {
    "format-wifi": "<span size='13000' foreground='#d79921'> </span>{essid} ",
    "format-ethernet": "<span size='13000' foreground='#d79921'> </span>{ifname} ",
    "format-linked": "<span size='13000' foreground='#d79921'></span>{ifname} ",
    "format-disconnected": "<span size='13000' foreground='#d79921'> </span>{ifname} ",
    "max-length": 25,
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
      "format": "<span size='13000' foreground='#458588'>{icon} </span>{volume}% ",
      "format-muted": "",
      "format-icons": {
          "default": ["", "", " "]
      },
      "on-click": "pavucontrol"
  },
  "custom/keyboard": {
    "format": "{}",
    "tooltip": false,
    "exec": "if [ -f \"${XDG_RUNTIME_DIR:-/tmp}/wvkbd.visible\" ]; then echo '{\"text\":\"󰌌\",\"class\":\"active\"}'; else echo '{\"text\":\"󰌌\",\"class\":\"inactive\"}'; fi",
    "return-type": "json",
    "interval": 1,
    "on-click": "zsh ~/.config/hypr/osk-toggle.sh"
  },
  "custom/power": {
    "format": "  ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "/home/kevinstampe/.config/waybar/power-menu.xml",
    "menu-actions": {
      "shutdown": "systemctl poweroff",
      "restart": "systemctl reboot",
      "logoff": "hyprctl dispatch exit"
    }
  }
}

