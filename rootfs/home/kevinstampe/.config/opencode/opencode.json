          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 200000, "output": 32768 }
        },
        "auto/fast": {
          "name": "Auto: Fast",
          "tool_call": true,
          "limit": { "context": 200000, "output": 32768 }
        }
      }
    },
    "local": {
      "npm": "@ai-sdk/openai-compatible",
