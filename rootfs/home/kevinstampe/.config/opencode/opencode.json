{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {},
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "caveman": {
      "type": "local",
      "command": [
        "/home/kevinstampe/.caveman/bin/caveman-mcp"
      ],
      "enabled": true
    }
  }
}
