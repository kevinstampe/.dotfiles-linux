{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    },
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "caveman": {
      "type": "local",
      "command": [
        "/home/kevinstampe/.caveman/bin/caveman-mcp"
      ],
      "enabled": true
    },
    "idea": {
      "type": "remote",
      "url": "http://127.0.0.1:64482/stream",
      "enabled": true
    }
  },
  "provider": {
    "openai": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/openai/v1"
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/anthropic/v1"
      }
    }
  }
}
