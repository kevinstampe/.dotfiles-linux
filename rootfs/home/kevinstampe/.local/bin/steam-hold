#!/bin/bash
# Double-press launcher for the ROG side button (XF86Launch3).
# The button is a momentary media key (firmware sends press+release instantly),
# so hold-duration can't be measured. Instead we require two presses within
# 1.5s to enter Steam Gaming Mode, avoiding accidental single taps.

STAMP=/tmp/steam-press.stamp
WINDOW_MS=1500

now=$(date +%s%3N)
last=$(cat "$STAMP" 2>/dev/null || echo 0)
echo "$now" > "$STAMP"

if [ "$((now - last))" -le "$WINDOW_MS" ]; then
    rm -f "$STAMP"
    exec "$HOME/.local/bin/steam-mode"
fi
