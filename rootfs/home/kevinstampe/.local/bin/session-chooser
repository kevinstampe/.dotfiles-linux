#!/bin/bash
# greetd runs this instead of start-hyprland directly.
# If the steam-mode flag exists, launch the full SteamOS-style gamescope session
# (gamescope-session-plus), which provides the Big Picture UI with working
# brightness slider, volume, power menu, and external-display preference.
# Otherwise launch the normal Hyprland session.
# When either exits, greetd respawns this chooser, giving a clean handoff.

FLAG=/tmp/steam-mode

if [ -f "$FLAG" ]; then
    rm -f "$FLAG"
    # Steam mode has no waybar icon or Super+V bind, so the tunnel would be
    # stuck on with no way to toggle it - and AllowedIPs=0.0.0.0/0 would route
    # all game traffic through the homelab gateway VM. Drop it before handing
    # off. Non-fatal: a failure here must not block the session.
    "$HOME/.local/bin/azvpn" down >/dev/null 2>&1 || true
    # Hyprland leaks WAYLAND_DISPLAY/DISPLAY into the systemd --user environment,
    # which the gamescope-session-plus@.service inherits. That makes gamescope
    # pick the nested wayland backend and crash ("Failed to connect to wayland
    # socket"). Clear them and force the DRM backend so gamescope drives the
    # display directly.
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XAUTHORITY
    systemctl --user set-environment BACKEND=drm
    exec gamescope-session-plus steam
fi

# Hyprland logs to $XDG_RUNTIME_DIR/hypr/<sig>/hyprland.log, which is tmpfs and
# is gone after a reboot - so when the compositor dies mid-session there is no
# post-mortem left. Run it non-exec, record the exit status in the journal, and
# archive the instance log under ~/.local/state/hypr/ so the last few sessions
# can be inspected afterwards.
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr"
STATEDIR="$HOME/.local/state/hypr"
mkdir -p "$STATEDIR"

start-hyprland
STATUS=$?

LOG=$(find "$RUNDIR" -maxdepth 2 -name hyprland.log -printf '%T@ %p\n' 2>/dev/null \
      | sort -rn | head -1 | cut -d' ' -f2-)
STAMP=$(date +%Y%m%d-%H%M%S)
if [ -n "$LOG" ]; then
    cp -- "$LOG" "$STATEDIR/hyprland-$STAMP-exit$STATUS.log"
fi
# Keep the 10 most recent archives, drop the rest.
ls -1t "$STATEDIR"/hyprland-*.log 2>/dev/null | tail -n +11 | xargs -r rm -f --

logger -t hypr-session "Hyprland session exited with status $STATUS (log: $STATEDIR/hyprland-$STAMP-exit$STATUS.log)"

exit "$STATUS"
