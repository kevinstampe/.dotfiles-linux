#!/usr/bin/env bash
# Volume keys, or brightness while brightness mode is armed by side-button.
#
# Usage: vol-or-bright up|down
#
# Brightness mode expires on its own, and every brightness adjustment re-arms
# it, so a run of adjustments does not need the side button tapped again.

set -euo pipefail

ARM=/tmp/brightness-mode.stamp
ARM_MS=3000
STEP_BRIGHT=10
STEP_VOL=5

dir="${1:?usage: vol-or-bright up|down}"

armed=false
if [[ -f "$ARM" ]]; then
    now=$(date +%s%3N)
    last=$(cat "$ARM" 2>/dev/null || echo 0)
    [[ $((now - last)) -le $ARM_MS ]] && armed=true
fi

if [[ "$armed" == true ]]; then
    case "$dir" in
        up)   brightnessctl -q s "+${STEP_BRIGHT}%" ;;
        down) brightnessctl -q s "${STEP_BRIGHT}%-" ;;
    esac

    date +%s%3N > "$ARM"   # keep the mode alive while it is being used

    # brightnessctl -m prints: device,class,raw,percent,max
    pct=$(brightnessctl -m | cut -d, -f4)
    notify-send -t 1500 -h string:x-canonical-private-synchronous:brightness-mode \
        -h "int:value:${pct%\%}" "Brightness" "$pct"
    exit 0
fi

case "$dir" in
    up)   wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "${STEP_VOL}%+" ;;
    down) wpctl set-volume @DEFAULT_AUDIO_SINK@ "${STEP_VOL}%-" ;;
esac
